# Server Configuration
PORT=5000
NODE_ENV=development

# Authentication
JWT_SECRET=your_jwt_secret_key_change_in_production_min_32_chars
JWT_EXPIRES_IN=24h

# Supabase PostgreSQL Configuration
# Found in: Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# MQTT Broker Configuration
# Example brokers: HiveMQ Cloud, EMQX, Mosquitto
# e.g., mqtts://your-cluster.hivemq.cloud:8883
MQTT_BROKER_URL=mqtts://your-mqtt-broker-url:8883
MQTT_USERNAME=your_mqtt_username
MQTT_PASSWORD=your_mqtt_password
MQTT_CLIENT_ID=gate-control-backend-001
MQTT_TLS=true

# Target Device Configuration
DEVICE_ID=GATE-001
HEARTBEAT_TIMEOUT_SECONDS=90

# Development / Testing Simulation Mode
# Set to 'true' to enable the built-in virtual ESP32 simulator without physical hardware
MOCK_DEVICE=true
